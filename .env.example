# ─── 飞书应用凭证（飞书开放平台 → 应用详情 → 凭证与基础信息）───
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 飞书文档存储目录（可选，不填则存到根目录）
FEISHU_FOLDER_TOKEN=

# ─── 大模型（GLM，走 Anthropic 兼容接口）───
ANTHROPIC_API_KEY=你的智谱GLM-API-KEY
# 智谱 GLM 的 Anthropic 兼容端点（用官方 Claude 则留空，默认 https://api.anthropic.com）
ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANTHROPIC_MODEL=glm-5.1
